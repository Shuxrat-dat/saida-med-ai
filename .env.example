# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Local Development:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saida_med_ai?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/saida_med_ai?schema=public"

# Production (Supabase PostgreSQL):
# DATABASE_URL uses Supabase Connection Pooler (port 6543, transaction mode for serverless Next.js):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL connects directly to PostgreSQL (port 5432) for running Prisma migrations:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ==============================================================================
# STORAGE CONFIGURATION (local | supabase | s3)
# ==============================================================================
# Set to "supabase" in production (Vercel) so files are not saved to ephemeral container disk
STORAGE_TYPE="supabase"

# Required when STORAGE_TYPE="supabase":
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="medical-materials"

# S3 / Cloudflare R2 credentials (optional fallback if STORAGE_TYPE="s3")
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_BUCKET_NAME=""
# S3_ENDPOINT=""

# ==============================================================================
# OPENAI & AI SERVICES
# ==============================================================================
# OpenAI API key (for GPT-4o Vision OCR, structured document analysis, question generation)
OPENAI_API_KEY="sk-proj-..."
OCR_PROVIDER="openai"

# ==============================================================================
# APPLICATION & AUTH
# ==============================================================================
NEXTAUTH_SECRET="generate-a-random-32-char-string"
# In local development: http://localhost:3000
# In production: https://saida-med-ai.vercel.app (your actual Vercel domain)
NEXTAUTH_URL="http://localhost:3000"

# Default credentials for student profile
DEFAULT_STUDENT_EMAIL="saida@med.ai"
DEFAULT_STUDENT_NAME="Saida"
